# Copy to .env (never commit .env). All values below are placeholders.

# MCP server
HDR_DB_PATH=var/hdr.sqlite3
HDR_MCP_HOST=127.0.0.1
HDR_MCP_PORT=8765
# Signs approval tokens. Generate one: python -c "import secrets; print(secrets.token_hex(32))"
HDR_APPROVAL_SECRET=
HDR_APPROVAL_TTL_SECONDS=900
# Enables /admin/reset and /admin/faults for the demo. Leave empty to disable them.
HDR_ADMIN_TOKEN=
HDR_VARIANT=

# Orchestrator (simulator API)
HDR_MCP_URL=http://127.0.0.1:8765/mcp
HDR_API_PORT=8766
# strands = LLM agent (falls back to rules per turn if no model is configured); rules = rule agent only
HDR_AGENT=strands
HDR_LLM_PROVIDER=gemini
# Free tier limits differ by model: Flash-Lite allows 500 requests/day, Flash models 20/day.
HDR_LLM_MODEL=gemini-3.5-flash-lite
# Free key from Google AI Studio. Leave billing off.
GEMINI_API_KEY=
# Optional JSON passed to the model. Default: {"thinking_config": {"thinking_level": "LOW"}}
HDR_LLM_PARAMS=
# Model attempts per call when the API is overloaded or rate-limited
HDR_LLM_RETRIES=4

# Simulator (Next.js)
NEXT_PUBLIC_HDR_API=http://127.0.0.1:8766

# Single-port server (python -m hdr.hosted; used by the Dockerfile)
# PORT=7860
# HDR_HOST=127.0.0.1
# HDR_STATIC_DIR=apps/simulator/out
# Public host names the MCP server should accept in the Host header (comma-separated).
# Hugging Face Spaces sets SPACE_HOST, which is used when this is empty.
HDR_PUBLIC_HOSTS=
